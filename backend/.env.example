# GitHub Personal Access Token (optional but increases rate limits from 60 to 5000 req/hr)
GITHUB_TOKEN=your_github_personal_access_token_here

# OpenAI-compatible API Key (works with Featherless, OpenAI, etc.)
OPENAI_API_KEY=your_api_key_here

# Base URL for OpenAI-compatible provider (leave empty for OpenAI, set for Featherless etc.)
OPENAI_BASE_URL=https://api.featherless.ai/v1

# Model to use
OPENAI_MODEL=unsloth/Llama-3.3-70B-Instruct

# Server port
PORT=3001

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173
