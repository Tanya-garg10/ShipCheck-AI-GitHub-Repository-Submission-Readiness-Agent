# GitHub Personal Access Token (optional but increases rate limits from 60 to 5000 req/hr)
GITHUB_TOKEN=your_github_personal_access_token_here

# Featherless AI API Key for AI recommendations
FEATHERLESS_API_KEY=your_featherless_api_key_here

# Featherless AI Base URL (default: https://api.featherless.ai/v1)
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Featherless AI Model (defaults to meta-llama/Llama-3.3-70B-Instruct)
FEATHERLESS_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Server port
PORT=3001

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173
